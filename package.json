{
    "name":  "dsh-skill-browser",
    "version": "1.8.3",
    "description":  "把技能库变成看得见、搜得到、管得住的资产：分类/中文简介/搜索/全文查看，并自动登记每次技能调用的失效台账。| Browse and govern your skill library: categories, search, full-text viewer, plus an automatic skill-failure ledger driven by tools/result.",
    "type":  "module",
    "main":  "lib/index.js",
    "sideEffects":  false,
    "engines":  {
                    "node":  "\u003e=18"
                },
    "exports":  {
                    ".":  "./lib/index.js",
                    "./client":  "./lib/client.js",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib/**/*.js",
                  "lib/**/*.ps1",
                  "cordis.patch.yml",
                  "README.md",
                  "LICENSE",
                  "lib/orb/*.html",
                  "docs/images/**"
                ],
    "license":  "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loyalchiiina/dsh-skill-browser.git"
  },
  "homepage": "https://github.com/loyalchiiina/dsh-skill-browser#readme",
    "keywords":  [
                     "dsh-plugin",
                     "deepseek-harness",
                     "skill",
                     "技能",
                     "skills-browser",
                     "skill-browser",
                     "fluent",
                     "cfd",
                     "分类",
                     "category",
                     "chinese",
                     "中文简介"
                 ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "inject":  [
                                              "@deepseek-ai/dsh-client-connection",
                                              "@deepseek-ai/dsh-client-runtime",
                                              "@deepseek-ai/dsh-client-ui-settings",
                                              "@deepseek-ai/dsh-client-ui-slots",
                                              "@deepseek-ai/dsh-client-locale"
                                          ],
                               "platform":  "web"
                           }
            }
}