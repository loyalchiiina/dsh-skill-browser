{
  "name": "dsh-skill-browser",
  "version": "1.9.9",
  "description": "技能浏览器：把 ~/.dsh/skills 里的技能做成可视化面板（搜索/分类/启停/详情/调用台账）。v1.9.0 自定义分组+版本号+AI 分组+AI 封面；v1.9.1 调用台账看板；v1.9.2 全皮肤自适应配色；v1.9.3 两级分组+滚动条+悬浮球层级；v1.9.4 面板⚡热重载；v1.9.5 吸顶表头不透明；v1.9.6 详情层隔离+分片渲染+增量读取；v1.9.7 关键词快速分组；v1.9.8 树状/平铺双模式分组栏；v1.9.9 零配置模型自动发现+全皮肤文字可见性加固。",
  "type": "module",
  "main": "lib/index.js",
  "sideEffects": false,
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "lib/**/*.js",
    "lib/**/*.ps1",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "lib/orb/*.html",
    "docs/images/**",
    "locale/*.json",
    "icon.svg",
    "README-zh.md",
    "README-es.md",
    "README-pt.md",
    "README-hi.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "技能",
    "skills-browser",
    "skill-browser",
    "fluent",
    "cfd",
    "分类",
    "category",
    "chinese",
    "中文简介"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.1 || ^0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh": ">=0.1.7-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loyalchiiina/dsh-skill-browser.git"
  },
  "homepage": "https://github.com/loyalchiiina/dsh-skill-browser#readme",
  "packageManager": "pnpm@11.7.0"
}
